{
  "name": "@otpusk/apisearch-toolbox",
  "version": "2.0.53",
  "description": "",
  "scripts": {
    "start": "babel-node ./playground",
    "transpile": "rm -rf dist && BABEL_ENV=cjs babel ./src --out-dir ./dist/cjs && BABEL_ENV=esm babel ./src --out-dir ./dist/esm",
    "publish-package": "npm publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otpusk/apisearch-toolbox.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/otpusk/apisearch-toolbox/issues"
  },
  "homepage": "https://github.com/otpusk/apisearch-toolbox#readme",
  "engines": {
    "node": ">=20"
  },
  "browserslist": [
    "since 2021"
  ],
  "dependencies": {
    "geolib": "3.3.3",
    "immutable": "4.0.0-rc.12",
    "moment": "2.29.4",
    "ramda": "0.29.0",
    "redux": "4.0.5",
    "redux-actions": "2.6.5",
    "redux-saga": "1.1.3",
    "reselect": "4.1.1"
  },
  "peerDependencies": {
    "@otpusk/excursion-api": "0.0.57",
    "@otpusk/json-api": "latest"
  },
  "devDependencies": {
    "@babel/cli": "7.24.5",
    "@babel/core": "7.24.5",
    "@babel/eslint-parser": "7.24.5",
    "@babel/node": "7.23.9",
    "@babel/preset-env": "7.24.5",
    "@otpusk/json-api": "latest",
    "eslint": "8.57.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    "./dist/excursion": {
      "import": "./dist/esm/excursion/index.js",
      "require": "./dist/cjs/excursion/index.js"
    },
    "./dist/excursionGeo": {
      "import": "./dist/esm/excursionGeo/index.js",
      "require": "./dist/cjs/excursionGeo/index.js"
    },
    "./dist/excursionSearch": {
      "import": "./dist/esm/excursionSearch/index.js",
      "require": "./dist/cjs/excursionSearch/index.js"
    },
    "./dist/excursionTours": {
      "import": "./dist/esm/excursionTours/index.js",
      "require": "./dist/cjs/excursionTours/index.js"
    },
    "./dist/geo": {
      "import": "./dist/esm/geo/index.js",
      "require": "./dist/cjs/geo/index.js"
    },
    "./dist/hotels": {
      "import": "./dist/esm/hotels/index.js",
      "require": "./dist/cjs/hotels/index.js"
    },
    "./dist/hotels/saga/workers": {
      "import": "./dist/esm/hotels/saga/workers/index.js",
      "require": "./dist/cjs/hotels/saga/workers/index.js"
    },
    "./dist/offers": {
      "import": "./dist/esm/offers/index.js",
      "require": "./dist/cjs/offers/index.js"
    },
    "./dist/offers/saga": {
      "import": "./dist/esm/offers/saga/index.js",
      "require": "./dist/cjs/offers/saga/index.js"
    },
    "./dist/operators": {
      "import": "./dist/esm/operators/index.js",
      "require": "./dist/cjs/operators/index.js"
    },
    "./dist/operators/saga/workers": {
      "import": "./dist/esm/operators/saga/workers/index.js",
      "require": "./dist/cjs/operators/saga/workers/index.js"
    },
    "./dist/queries": {
      "import": "./dist/esm/queries/index.js",
      "require": "./dist/cjs/queries/index.js"
    },
    "./dist/queries/saga": {
      "import": "./dist/esm/queries/saga/index.js",
      "require": "./dist/cjs/queries/saga/index.js"
    },
    "./dist/queries/saga/workers": {
      "import": "./dist/esm/queries/saga/workers/index.js",
      "require": "./dist/cjs/queries/saga/workers/index.js"
    },
    "./dist/search": {
      "import": "./dist/esm/search/index.js",
      "require": "./dist/cjs/search/index.js"
    },
    "./dist/search/saga/workers": {
      "import": "./dist/esm/search/saga/workers/index.js",
      "require": "./dist/cjs/search/saga/workers/index.js"
    },
    "./dist/search/saga/workers/getResultsWorker": {
      "import": "./dist/esm/search/saga/workers/getResultsWorker/index.js",
      "require": "./dist/cjs/search/saga/workers/getResultsWorker/index.js"
    },
    "./dist/services": {
      "import": "./dist/esm/services/index.js",
      "require": "./dist/cjs/services/index.js"
    },
    "./dist/*": {
      "import": "./dist/esm/*.js",
      "require": "./dist/cjs/*.js"
    }
  }
}
